{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "mcp": {
      "injectIntoAgents": false
    }
  },
  "agents": {
    "providers": {
      "claude-lead": {
        "extends": "claude",
        "label": "Claude Lead",
        "description": "Orchestration owner using the role-gated Paseo CLI facade.",
        "command": ["claude"],
        "env": {
          "CLAUDE_CONFIG_DIR": "__CLAUDE_ROLES_HOME__/lead",
          "PASEO_CLAUDE_ROLE": "lead",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "claude-worker": {
        "extends": "claude",
        "label": "Claude Worker",
        "description": "Bounded implementation agent with no orchestration authority.",
        "command": ["claude"],
        "env": {
          "CLAUDE_CONFIG_DIR": "__CLAUDE_ROLES_HOME__/worker",
          "PASEO_CLAUDE_ROLE": "worker",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "claude-reviewer": {
        "extends": "claude",
        "label": "Claude Reviewer",
        "description": "Independent behaviorally read-only reviewer with no orchestration authority.",
        "command": ["claude"],
        "env": {
          "CLAUDE_CONFIG_DIR": "__CLAUDE_ROLES_HOME__/reviewer",
          "PASEO_CLAUDE_ROLE": "reviewer",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "claude-supervisor": {
        "extends": "claude",
        "label": "Claude Supervisor",
        "description": "Governance observer using the role-gated CLI monitoring/recovery surface.",
        "command": ["claude"],
        "env": {
          "CLAUDE_CONFIG_DIR": "__CLAUDE_ROLES_HOME__/supervisor",
          "PASEO_CLAUDE_ROLE": "supervisor",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      }
    }
  }
}

{
  "$comment": "Peer role. No Paseo MCP. The CURRENT-turn V3 brief binds disposition and authority: only engineer + MODE: write can mutate within OWNED_SCOPE; scout/architect/reviewer/shadow remain non-mutating. Malformed hook state blocks the turn. Native Agent/Task tools + web denied.",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": ["Agent", "WebSearch", "WebFetch"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Artifact|Agent|Task|mcp__paseo__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/user-prompt-submit.mjs\""
          }
        ]
      }
    ]
  }
}

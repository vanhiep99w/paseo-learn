{
  "$comment": "Supervisor role. Observe-only via Read plus Bash restricted by hook to the role-gated paseo-team monitoring/recovery facade. Write/edit, native Agent/Task, MCP, and web tools are denied or hook-blocked.",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Artifact",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Artifact|Agent|Task|mcp__paseo__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/user-prompt-submit.mjs\""
          }
        ]
      }
    ]
  }
}

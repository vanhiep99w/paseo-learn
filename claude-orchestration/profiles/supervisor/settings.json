{
  "$comment": "Supervisor role. Observe-only via Read plus the five-tool Paseo MCP monitoring/recovery allowlist. Shell and write/edit tools are denied and hook-blocked. create_agent is gated to claude-lead recovery. Native Agent/Task tools + web denied.",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Agent",
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Artifact",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Artifact|Agent|Task|mcp__paseo__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/user-prompt-submit.mjs\""
          }
        ]
      }
    ]
  }
}

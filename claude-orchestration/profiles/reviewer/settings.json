{
  "$comment": "Reviewer role. Claude Code plan mode plus explicit write/edit denials enforce read-only inspection; the hook additionally blocks git mutations and Paseo CLI use. No paseo MCP. Native Agent/Task tools + web denied.",
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Agent",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Artifact",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Artifact|Agent|Task|mcp__paseo__.*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_CONFIG_DIR}/hooks/user-prompt-submit.mjs\""
          }
        ]
      }
    ]
  }
}

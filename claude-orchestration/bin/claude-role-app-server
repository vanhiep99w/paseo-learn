#!/usr/bin/env bash
set -euo pipefail

# claude-role-app-server — selective Paseo MCP injector for the Claude Code
# role pack.
#
# Mirrors pi-role-app-server / codex-role-app-server. Paseo daemon-wide MCP
# injection is OFF (daemon.mcp.injectIntoAgents=false); only providers that set
# PASEO_MCP_ACCESS=lead|supervisor reach this launcher. It derives the
# agent-scoped MCP URL from PASEO_AGENT_ID and injects the paseo MCP server to
# Claude Code via an inline --mcp-config JSON. Worker/Reviewer use plain
# `claude` (no launcher, no injection), so they get no paseo server and cannot
# orchestrate.
#
# The launcher adds NO filesystem sandbox. Claude Code runs full-access
# (permissions defaultMode bypassPermissions); role behavior is bounded by the
# role CLAUDE.md (system prompt), the per-role permissions.deny list, and the
# policy hooks (PreToolUse/UserPromptSubmit) under $CLAUDE_CONFIG_DIR/hooks.

# Paseo probes only the configured executable with --version, without the
# command-prefix arguments from config.json.
if [[ "${1:-}" == "--version" ]]; then
	exec claude --version
fi

if ! command -v claude >/dev/null 2>&1; then
	echo "claude-role-app-server: claude is not on PATH" >&2
	exit 127
fi

agent_dir_input="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
agent_dir="$(realpath -m "$agent_dir_input")"
launcher_dir="$(pwd -P)"
workspace_dir="$launcher_dir"
paseo_agent_scoped=false

if [[ -n "${PASEO_AGENT_ID:-}" && -n "${PASEO_AGENT_CWD:-}" ]]; then
	paseo_agent_scoped=true
	workspace_dir="$(realpath -m "$PASEO_AGENT_CWD")"
fi

# Daemon-wide MCP injection is disabled. Only providers declaring
# PASEO_MCP_ACCESS receive the agent-scoped paseo server, injected here as an
# inline --mcp-config JSON (the Claude Code equivalent of codex's
# `mcp_servers.paseo.url=...` -c override). The supervisor's 11-tool allowlist
# is enforced by the PreToolUse hook, not by this config (Claude Code's MCP
# config has no per-tool includeTools field).
claude_args=()
case "${PASEO_MCP_ACCESS:-}" in
	"")
		;;
	lead | supervisor)
		if [[ "$paseo_agent_scoped" != true ]]; then
			# Discovery probes have no stable agent identity, so they must not get
			# an agent-scoped MCP URL. Inject nothing; the probe runs without paseo.
			:
		elif [[ ! "$PASEO_AGENT_ID" =~ ^[A-Za-z0-9_-]+$ ]]; then
			echo "claude-role-app-server: invalid PASEO_AGENT_ID" >&2
			exit 2
		else
			paseo_mcp_base_url="${PASEO_MCP_BASE_URL:-http://127.0.0.1:6767/mcp/agents}"
			mcp_url="${paseo_mcp_base_url}?callerAgentId=${PASEO_AGENT_ID}"
			# Build the MCP config JSON. The URL is resolved here (safe, no secret).
			# The bearer token is referenced by env-var NAME so the secret is never
			# placed in argv; Claude Code expands ${PASEO_MCP_BEARER_TOKEN} at load.
			if [[ -n "${PASEO_MCP_BEARER_TOKEN:-}" ]]; then
				mcp_config='{"mcpServers":{"paseo":{"type":"http","url":"'"${mcp_url}"'","lifecycle":"lazy","headers":{"Authorization":"Bearer ${PASEO_MCP_BEARER_TOKEN}"}}}}'
			else
				mcp_config='{"mcpServers":{"paseo":{"type":"http","url":"'"${mcp_url}"'","lifecycle":"lazy"}}}'
			fi
			claude_args+=(--mcp-config "$mcp_config")
		fi
		;;
	*)
		echo "claude-role-app-server: unsupported PASEO_MCP_ACCESS role" >&2
		exit 2
		;;
esac

if [[ ! -d "$agent_dir" ]]; then
	echo "claude-role-app-server: CLAUDE_CONFIG_DIR does not exist: $agent_dir" >&2
	exit 2
fi

# Guard against the agent config dir and the workspace overlapping, which would
# let an agent edit its own role resources or credentials.
if [[ "$workspace_dir" == "$agent_dir" ||
	"$workspace_dir" == "$agent_dir"/* ||
	"$agent_dir" == "$workspace_dir"/* ]] &&
	[[ "$paseo_agent_scoped" == true ]]; then
	echo "claude-role-app-server: workspace and CLAUDE_CONFIG_DIR must not overlap (workspace=$workspace_dir, agent_dir=$agent_dir)" >&2
	exit 2
fi

# Forward every argument Paseo would normally pass to claude (the Agent SDK /
# headless args). CLAUDE_CONFIG_DIR, PASEO_CLAUDE_ROLE and PASEO_MCP_ACCESS come
# from the provider env; the injected --mcp-config (when present) precedes "$@".
exec claude "${claude_args[@]}" "$@"

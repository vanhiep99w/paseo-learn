#!/usr/bin/env node

/**
 * Role-gated Paseo CLI facade for paseo-learn orchestration packs.
 *
 * This wrapper deliberately shells out to the public `paseo` CLI. It is not a
 * second control plane and does not call the daemon API or MCP directly.
 */

import { createHash } from "node:crypto";
import { spawn, spawnSync } from "node:child_process";
import {
	closeSync,
	existsSync,
	mkdirSync,
	openSync,
	readFileSync,
	renameSync,
	unlinkSync,
	writeFileSync,
} from "node:fs";
import { homedir } from "node:os";
import path from "node:path";

const ROLE_ENVS = [
	["PASEO_PI_ROLE", "pi"],
	["PASEO_CLAUDE_ROLE", "claude"],
	["PASEO_CODEX_ROLE", "codex"],
];
const ID_RE = /^[A-Za-z0-9][A-Za-z0-9._:-]*$/;
const PROVIDER_RE = /^[A-Za-z0-9][A-Za-z0-9._-]*\/.+$/;

function fail(message, code = 2) {
	console.error(`paseo-team: ${message}`);
	process.exit(code);
}

let paseoLaunchSpec;

function windowsPaseoCandidates() {
	const configured = process.env.PASEO_CLI?.trim().replace(/^['"]|['"]$/g, "");
	const candidates = configured ? [configured] : [];
	const extensions = ["", ...(process.env.PATHEXT || ".COM;.EXE;.BAT;.CMD")
		.split(";")
		.filter(Boolean)];
	for (const directory of (process.env.PATH || "").split(path.delimiter).filter(Boolean)) {
		for (const extension of extensions) {
			candidates.push(path.join(directory, `paseo${extension}`));
		}
	}
	return [...new Set(candidates)];
}

function paseoScriptFromCmd(commandPath) {
	const directory = path.dirname(commandPath);
	for (const candidate of [
		path.join(directory, "node_modules", "@getpaseo", "cli", "bin", "paseo"),
		path.join(directory, "node_modules", "@getpaseo", "cli", "bin", "paseo.js"),
	]) {
		if (existsSync(candidate)) return candidate;
	}
	try {
		const expanded = readFileSync(commandPath, "utf8")
			.replaceAll(/%~dp0/gi, `${directory}${path.sep}`)
			.replaceAll(/%dp0%/gi, `${directory}${path.sep}`);
		const match = expanded.match(/(?:node(?:\.exe)?|"[^"]*node(?:\.exe)?")\s+"([^"]+)"/i);
		if (match?.[1] && existsSync(match[1])) return match[1];
	} catch {
		// Fall through to the actionable error below.
	}
	return "";
}

function resolvePaseoLaunchSpec() {
	if (paseoLaunchSpec) return paseoLaunchSpec;
	if (process.platform !== "win32") {
		paseoLaunchSpec = { command: "paseo", prefix: [] };
		return paseoLaunchSpec;
	}
	const override = process.env.PASEO_TEAM_PASEO_JS?.trim();
	if (override) {
		if (!existsSync(override)) fail(`PASEO_TEAM_PASEO_JS does not exist: ${override}`, 1);
		paseoLaunchSpec = { command: process.execPath, prefix: [override] };
		return paseoLaunchSpec;
	}
	for (const candidate of windowsPaseoCandidates()) {
		if (!existsSync(candidate)) continue;
		const extension = path.extname(candidate).toLowerCase();
		if (extension === ".exe" || extension === ".com") {
			paseoLaunchSpec = { command: candidate, prefix: [] };
			return paseoLaunchSpec;
		}
		if (extension === ".cmd" || extension === ".bat") {
			const script = paseoScriptFromCmd(candidate);
			if (script) {
				paseoLaunchSpec = { command: process.execPath, prefix: [script] };
				return paseoLaunchSpec;
			}
		}
	}
	fail(
		"cannot resolve the Windows Paseo CLI entrypoint; install @getpaseo/cli with npm or set PASEO_TEAM_PASEO_JS to its bin/paseo script",
		1,
	);
}

function spawnPaseoSync(args, options) {
	const spec = resolvePaseoLaunchSpec();
	return spawnSync(spec.command, [...spec.prefix, ...args], options);
}

function spawnPaseo(args, options) {
	const spec = resolvePaseoLaunchSpec();
	return spawn(spec.command, [...spec.prefix, ...args], options);
}

function detectCaller() {
	const found = ROLE_ENVS.filter(([name]) => process.env[name]);
	if (found.length !== 1) {
		fail("exactly one Paseo role environment must be set");
	}
	const [envName, family] = found[0];
	const role = process.env[envName];
	if (!["lead", "worker", "reviewer", "supervisor"].includes(role)) {
		fail(`unsupported role ${JSON.stringify(role)}`);
	}
	if (!process.env.PASEO_AGENT_ID) {
		fail("PASEO_AGENT_ID is required; orchestration is agent-scoped only");
	}
	return { family, role };
}

function runPaseo(args, { capture = false } = {}) {
	const result = spawnPaseoSync(args, {
		encoding: capture ? "utf8" : undefined,
		stdio: capture ? ["ignore", "pipe", "pipe"] : "inherit",
		env: process.env,
	});
	if (result.error) fail(`cannot execute paseo: ${result.error.message}`, 1);
	if (capture && result.status !== 0) {
		if (result.stderr) process.stderr.write(result.stderr);
		fail(`paseo ${args[0]} failed`, result.status || 1);
	}
	if (!capture) process.exit(result.status ?? 1);
	return result.stdout;
}

function requireNoArgs(args, command) {
	if (args.length) fail(`${command} accepts no arguments`);
}

function requireId(value, label = "agent id") {
	if (!value || !ID_RE.test(value)) fail(`invalid ${label}`);
	return value;
}

function splitPrompt(args) {
	const separator = args.indexOf("--");
	if (separator === -1) fail("prompt must follow a `--` separator");
	const options = args.slice(0, separator);
	const promptParts = args.slice(separator + 1);
	if (promptParts.length !== 1 || !promptParts[0].trim()) {
		fail("prompt must be one non-empty shell argument after `--`");
	}
	return { options, prompt: promptParts[0] };
}

function parseAllowedOptions(args, spec) {
	const out = [];
	const seen = new Map();
	for (let i = 0; i < args.length; i += 1) {
		const flag = args[i];
		const rule = spec[flag];
		if (!rule) fail(`option ${JSON.stringify(flag)} is not allowed`);
		if (rule.repeat !== true && seen.has(flag)) fail(`duplicate option ${flag}`);
		const value = args[++i];
		if (value === undefined || value.startsWith("--")) fail(`${flag} requires a value`);
		if (rule.values && !rule.values.includes(value)) fail(`invalid value for ${flag}`);
		if (rule.pattern && !rule.pattern.test(value)) fail(`invalid value for ${flag}`);
		seen.set(flag, value);
		out.push(flag, value);
	}
	return { argv: out, seen };
}

const RUN_OPTIONS = {
	"--provider": { pattern: PROVIDER_RE },
	"--thinking": { pattern: ID_RE },
	"--mode": { pattern: ID_RE },
	"--title": {},
	"--label": { repeat: true, pattern: /^[^=\s]+=[^=]+$/ },
};

function validateSupervisorLeadTarget(id, family) {
	const raw = runPaseo(["inspect", id, "--json"], { capture: true });
	let info;
	try {
		info = JSON.parse(raw);
	} catch {
		fail("cannot parse paseo inspect output", 1);
	}
	if (info.Provider !== `${family}-lead`) {
		fail(`supervisor may message only ${family}-lead agents`);
	}
}

function commandRun(args, caller) {
	if (caller.role !== "lead" && caller.role !== "supervisor") fail("run is not allowed for this role");
	const { options, prompt } = splitPrompt(args);
	const parsed = parseAllowedOptions(options, RUN_OPTIONS);
	const provider = parsed.seen.get("--provider");
	const thinking = parsed.seen.get("--thinking");
	if (!provider) fail("run requires an exact --provider <role-provider/model> route");
	if (!thinking) fail("run requires --thinking; daemon defaults are forbidden");

	if (caller.role === "supervisor") {
		if (!provider.startsWith(`${caller.family}-lead/`)) {
			fail(`supervisor recovery provider must start with ${caller.family}-lead/`);
		}
		const labels = [];
		for (let i = 0; i < parsed.argv.length; i += 2) {
			if (parsed.argv[i] === "--label") labels.push(parsed.argv[i + 1]);
		}
		const purpose = labels.find((label) => label.startsWith("purpose="))?.slice(8);
		const recoveryFor = labels.find((label) => label.startsWith("recovery_for="))?.slice(13);
		if (!["recovery", "bootstrap"].includes(purpose) || !recoveryFor) {
			fail("supervisor run requires purpose=recovery|bootstrap and recovery_for=<project> labels");
		}
	}

	runPaseo(["run", "--background", "--quiet", ...parsed.argv, prompt]);
}

function commandSend(args, caller) {
	const { options, prompt } = splitPrompt(args);
	if (options.length !== 1) fail("send syntax: send <agent-id> -- <prompt>");
	const id = requireId(options[0]);
	if (caller.role === "supervisor") validateSupervisorLeadTarget(id, caller.family);
	runPaseo(["send", id, "--no-wait", "--json", prompt]);
}

function watcherDirectory() {
	const paseoHome = process.env.PASEO_HOME?.trim() || path.join(homedir(), ".paseo");
	return path.join(paseoHome, "paseo-team-watchers");
}

function watcherStatePath(batchId) {
	return path.join(watcherDirectory(), `${batchId}.json`);
}

function writeWatcherState(batchId, state) {
	const directory = watcherDirectory();
	mkdirSync(directory, { recursive: true, mode: 0o700 });
	const target = watcherStatePath(batchId);
	const temporary = `${target}.tmp.${process.pid}`;
	writeFileSync(temporary, `${JSON.stringify(state, null, 2)}\n`, {
		encoding: "utf8",
		mode: 0o600,
		flag: "wx",
	});
	renameSync(temporary, target);
}

function createWatcherState(batchId, state) {
	const directory = watcherDirectory();
	mkdirSync(directory, { recursive: true, mode: 0o700 });
	const target = watcherStatePath(batchId);
	let descriptor;
	try {
		descriptor = openSync(target, "wx", 0o600);
		writeFileSync(descriptor, `${JSON.stringify(state, null, 2)}\n`, "utf8");
		closeSync(descriptor);
		return true;
	} catch (error) {
		if (descriptor !== undefined) closeSync(descriptor);
		if (error?.code === "EEXIST") return false;
		throw error;
	}
}

function watcherBatchId(parentId, agentIds) {
	const digest = createHash("sha256")
		.update([parentId, ...[...agentIds].sort()].join("\0"))
		.digest("hex")
		.slice(0, 16);
	return `batch-${digest}`;
}

const WATCH_DEBOUNCE_MS = 1_200;
const WATCH_PERMISSION_RECHECK_MS = 2_000;
const MAX_WAIT_OUTPUT_CHARS = 1_000_000;

function watcherWaitResult(agentId) {
	return new Promise((resolve) => {
		let stdout = "";
		let settled = false;
		const waiter = spawnPaseo(["wait", agentId, "--json"], {
			stdio: ["ignore", "pipe", "ignore"],
			env: process.env,
		});
		waiter.stdout.setEncoding("utf8");
		waiter.stdout.on("data", (chunk) => {
			if (stdout.length < MAX_WAIT_OUTPUT_CHARS) {
				stdout += chunk.slice(0, MAX_WAIT_OUTPUT_CHARS - stdout.length);
			}
		});
		waiter.on("error", () => {
			if (settled) return;
			settled = true;
			resolve({ agentId, status: "error", errorCode: "WAIT_EXEC_FAILED" });
		});
		waiter.on("close", (code) => {
			if (settled) return;
			settled = true;
			if (code !== 0) {
				resolve({ agentId, status: "error", errorCode: "WAIT_FAILED" });
				return;
			}
			try {
				const parsed = JSON.parse(stdout);
				resolve({
					agentId: parsed.agentId || agentId,
					status: typeof parsed.status === "string" ? parsed.status : "unknown",
				});
			} catch {
				resolve({ agentId, status: "error", errorCode: "WAIT_OUTPUT_INVALID" });
			}
		});
	});
}

function watcherPermissionDetails(agentId) {
	const result = spawnPaseoSync(["inspect", agentId, "--json"], {
		encoding: "utf8",
		stdio: ["ignore", "pipe", "pipe"],
		env: process.env,
	});
	if (result.error || result.status !== 0) {
		return { permissionKey: "permission-unknown", pendingPermissionCount: null };
	}
	try {
		const parsed = JSON.parse(result.stdout);
		const pending = Array.isArray(parsed.PendingPermissions)
			? parsed.PendingPermissions
			: Array.isArray(parsed.pendingPermissions)
				? parsed.pendingPermissions
				: [];
		const pendingPermissionIds = pending
			.map((permission) =>
				permission?.id ?? permission?.Id ?? permission?.requestId ?? permission?.request_id,
			)
			.filter((id) => typeof id === "string" && id.length > 0);
		const permissionKey = pendingPermissionIds.length > 0
			? createHash("sha256").update(pendingPermissionIds.sort().join("\0")).digest("hex").slice(0, 16)
			: "permission-unknown";
		return {
			permissionKey,
			pendingPermissionCount: pending.length,
			...(pendingPermissionIds.length > 0 ? { pendingPermissionIds } : {}),
		};
	} catch {
		return { permissionKey: "permission-unknown", pendingPermissionCount: null };
	}
}

function watcherResultSummary(result) {
	return {
		agentId: result.agentId,
		status: result.status,
		...(result.errorCode ? { errorCode: result.errorCode } : {}),
		...(typeof result.pendingPermissionCount === "number"
			? { pendingPermissionCount: result.pendingPermissionCount }
			: {}),
		...(result.pendingPermissionIds
			? { pendingPermissionIds: result.pendingPermissionIds }
			: {}),
	};
}

function watcherDelay(milliseconds) {
	return new Promise((resolve) => setTimeout(resolve, milliseconds));
}

function sendWatcherNotification(parentId, batchId, results, remaining) {
	const needsAttention = results.some((result) => result.status !== "idle");
	const event = needsAttention
		? "PASEO_TEAM_AGENT_ATTENTION"
		: remaining === 0
			? "PASEO_TEAM_BATCH_COMPLETED"
			: "PASEO_TEAM_AGENT_COMPLETED";
	const prompt = [
		event,
		`BATCH_ID: ${batchId}`,
		`COMPLETED_IN_EVENT: ${results.length}`,
		`REMAINING: ${remaining}`,
		`RESULTS_JSON: ${JSON.stringify(results.map(watcherResultSummary))}`,
		`BATCH_COMPLETE: ${remaining === 0 ? "yes" : "no"}`,
		needsAttention
			? "ACTION: Gọi inspect ngay. Nếu permission, báo Human xử lý; không tự approve. Gọi logs --tail 1 nếu cần câu hỏi/error context."
			: "ACTION: Lead tự quyết định thứ tự lấy logs --tail 1, nhưng phải đọc response trước accept hoặc bước phụ thuộc; không gọi wait/poll.",
	].join("\n");
	const sent = spawnPaseoSync(
		["send", parentId, "--no-wait", "--json", prompt],
		{ encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], env: process.env },
	);
	return !sent.error && sent.status === 0;
}

async function commandNotifyWorker(args, caller) {
	if (caller.role !== "lead") fail("completion watcher is Lead-only");
	const [batchId, ...agentIds] = args;
	if (!batchId || !/^batch-[a-f0-9]{16}$/.test(batchId)) fail("invalid watcher batch id");
	if (agentIds.length === 0) fail("completion watcher requires agent ids");
	const parentId = requireId(process.env.PASEO_AGENT_ID, "parent agent id");
	const completed = [];
	const attentionEvents = [];
	const completedInputIds = new Set();
	let notificationFailures = 0;
	let notificationsSent = 0;
	let buffer = [];
	let remaining = agentIds.length;
	let flushTimer = null;
	let flushChain = Promise.resolve();

	const persistState = (state) => {
		writeWatcherState(batchId, {
			batchId,
			mode: "notify-each",
			parentAgentId: parentId,
			agentIds,
			completed,
			attentionEvents,
			remainingAgentIds: agentIds.filter((agentId) => !completedInputIds.has(agentId)),
			notificationsSent,
			notificationFailures,
			state,
			updatedAt: new Date().toISOString(),
		});
	};

	const enqueueFlush = () => {
		if (buffer.length === 0) return;
		const eventResults = buffer;
		const remainingAtFlush = remaining;
		buffer = [];
		flushChain = flushChain.then(() => {
			const sent = sendWatcherNotification(
				parentId,
				batchId,
				eventResults,
				remainingAtFlush,
			);
			if (sent) notificationsSent += 1;
			else notificationFailures += 1;
			persistState(remaining === 0 ? "finishing" : "watching");
		});
	};

	const scheduleFlush = (isFinal, isUrgent) => {
		if (flushTimer) {
			clearTimeout(flushTimer);
			flushTimer = null;
		}
		if (isFinal || isUrgent) {
			enqueueFlush();
			return;
		}
		flushTimer = setTimeout(() => {
			flushTimer = null;
			enqueueFlush();
		}, WATCH_DEBOUNCE_MS);
	};

	persistState("watching");
	await Promise.all(agentIds.map(async (agentId) => {
		const validAgentId = requireId(agentId);
		const notifiedPermissionKeys = new Set();
		while (true) {
			const result = await watcherWaitResult(validAgentId);
			if (result.status === "permission") {
				const details = watcherPermissionDetails(validAgentId);
				if (!notifiedPermissionKeys.has(details.permissionKey)) {
					notifiedPermissionKeys.add(details.permissionKey);
					const attention = { ...result, ...details };
					attentionEvents.push({
						...watcherResultSummary(attention),
						notifiedAt: new Date().toISOString(),
					});
					buffer.push(attention);
					scheduleFlush(false, true);
				}
				await watcherDelay(WATCH_PERMISSION_RECHECK_MS);
				continue;
			}
			completedInputIds.add(agentId);
			completed.push(watcherResultSummary(result));
			buffer.push(result);
			remaining -= 1;
			scheduleFlush(remaining === 0, result.status !== "idle");
			return;
		}
	}));
	if (flushTimer) clearTimeout(flushTimer);
	enqueueFlush();
	await flushChain;
	persistState(notificationFailures === 0 ? "notified" : "notification-failed");
	if (notificationFailures > 0) process.exitCode = 1;
}

function commandNotifyEach(args, caller) {
	if (caller.role !== "lead") fail("notify-each is Lead-only");
	if (args.length === 0 || args.length > 32) {
		fail("notify-each requires 1-32 agent ids");
	}
	const parentId = requireId(process.env.PASEO_AGENT_ID, "parent agent id");
	const agentIds = [...new Set(args.map((agentId) => requireId(agentId)))];
	if (agentIds.length !== args.length) fail("notify-each rejects duplicate agent ids");
	if (agentIds.includes(parentId)) fail("Lead cannot watch itself");
	const batchId = watcherBatchId(parentId, ["notify-each-v2-status-only", ...agentIds]);
	const initialState = {
		batchId,
		mode: "notify-each",
		parentAgentId: parentId,
		agentIds,
		state: "registered",
		registeredAt: new Date().toISOString(),
	};
	if (!createWatcherState(batchId, initialState)) {
		let existing = { batchId, state: "already-registered" };
		try {
			existing = JSON.parse(readFileSync(watcherStatePath(batchId), "utf8"));
		} catch {
			// Keep the fail-closed summary when an existing state cannot be read.
		}
		console.log(JSON.stringify({ ...existing, alreadyRegistered: true }));
		return;
	}

	writeWatcherState(batchId, { ...initialState, state: "watching" });
	let watcher;
	try {
		watcher = spawn(
			process.execPath,
			[path.resolve(process.argv[1]), "__notify-worker", batchId, ...agentIds],
			{ detached: true, stdio: "ignore", env: process.env },
		);
		watcher.unref();
	} catch (error) {
		unlinkSync(watcherStatePath(batchId));
		fail(`cannot start completion watcher: ${error.message}`, 1);
	}
	console.log(JSON.stringify({
		batchId,
		mode: "notify-each",
		state: "watching",
		watcherPid: watcher.pid,
		agentIds,
	}));
}

async function main() {
	const caller = detectCaller();
	const [command, ...args] = process.argv.slice(2);
	if (!command || command === "help" || command === "--help") {
		console.log("paseo-team commands: providers, models, ls, inspect, logs, send, wait, notify-each, run, archive");
		return;
	}
	if (["worker", "reviewer"].includes(caller.role)) {
		fail(`${caller.role} has no orchestration authority`);
	}

	switch (command) {
		case "providers":
			requireNoArgs(args, command);
			runPaseo(["provider", "ls", "--json"]);
			break;
		case "models":
			if (args.length !== 1 || !ID_RE.test(args[0])) fail("models requires one provider id");
			runPaseo(["provider", "models", args[0], "--thinking", "--json"]);
			break;
		case "ls": {
			const allowed = new Set(["--all", "--global"]);
			if (args.some((arg) => !allowed.has(arg))) fail("ls accepts only --all and --global");
			runPaseo(["ls", ...(args.includes("--all") ? ["--all"] : []), ...(args.includes("--global") ? ["--global"] : []), "--json"]);
			break;
		}
		case "inspect":
			if (args.length !== 1) fail("inspect requires one agent id");
			runPaseo(["inspect", requireId(args[0]), "--json"]);
			break;
		case "logs": {
			const id = requireId(args[0]);
			if (args.length === 1) runPaseo(["logs", id]);
			else if (args.length === 3 && args[1] === "--tail" && /^\d+$/.test(args[2])) runPaseo(["logs", id, "--tail", args[2]]);
			else fail("logs syntax: logs <agent-id> [--tail <n>]");
			break;
		}
		case "send":
			commandSend(args, caller);
			break;
		case "wait":
			if (caller.role !== "lead") fail("wait is Lead-only");
			if (args.length === 1) runPaseo(["wait", requireId(args[0])]);
			else if (args.length === 3 && args[1] === "--timeout" && /^\d+$/.test(args[2])) runPaseo(["wait", requireId(args[0]), "--timeout", args[2]]);
			else fail("wait syntax: wait <agent-id> [--timeout <seconds>]");
			break;
		case "notify-each":
			commandNotifyEach(args, caller);
			break;
		case "__notify-worker":
			await commandNotifyWorker(args, caller);
			break;
		case "run":
			commandRun(args, caller);
			break;
		case "archive":
			if (caller.role !== "lead" || args.length !== 1) fail("archive is Lead-only and requires one agent id");
			runPaseo(["archive", requireId(args[0]), "--json"]);
			break;
		case "workspace-ls":
		case "workspace-create":
		case "workspace-archive":
			fail("workspace management is disabled; every subagent must inherit the Lead's current workspace");
			break;
		default:
			fail(`unknown command ${JSON.stringify(command)}`);
	}
}

await main();

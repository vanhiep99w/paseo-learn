{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "mcp": {
      "injectIntoAgents": false
    }
  },
  "agents": {
    "providers": {
      "pi-lead": {
        "extends": "pi",
        "label": "Pi Lead",
        "description": "Orchestration owner using the role-gated Paseo CLI facade.",
        "command": ["pi"],
        "env": {
          "PI_CODING_AGENT_DIR": "__PI_ROLES_HOME__/lead",
          "PASEO_PI_ROLE": "lead",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "pi-worker": {
        "extends": "pi",
        "label": "Pi Worker",
        "description": "Bounded implementation agent with no orchestration authority.",
        "command": ["pi"],
        "env": {
          "PI_CODING_AGENT_DIR": "__PI_ROLES_HOME__/worker",
          "PASEO_PI_ROLE": "worker",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "pi-reviewer": {
        "extends": "pi",
        "label": "Pi Reviewer",
        "description": "Independent behaviorally read-only reviewer with no orchestration authority.",
        "command": ["pi"],
        "env": {
          "PI_CODING_AGENT_DIR": "__PI_ROLES_HOME__/reviewer",
          "PASEO_PI_ROLE": "reviewer",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      },
      "pi-supervisor": {
        "extends": "pi",
        "label": "Pi Supervisor",
        "description": "Governance observer using the role-gated CLI monitoring/recovery surface.",
        "command": ["pi"],
        "env": {
          "PI_CODING_AGENT_DIR": "__PI_ROLES_HOME__/supervisor",
          "PASEO_PI_ROLE": "supervisor",
          "PASEO_TEAM_CLI": "__PASEO_HOME__/bin/paseo-team"
        }
      }
    }
  }
}
